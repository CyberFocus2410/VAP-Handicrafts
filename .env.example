# ==============================================================================
# VAP Handicrafts — Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://vaphandicrafts.com
NEXT_PUBLIC_BRAND_NAME="VAP Handicrafts"

# Supabase Production Database & Storage
NEXT_PUBLIC_SUPABASE_URL=https://qepfiubmjueooacemhzz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_32_character_random_admin_session_secret

# Resend Transactional Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="VAP Handicrafts <orders@vaphandicrafts.com>"
ADMIN_NOTIFICATION_EMAIL="vaphandicrafts@gmail.com"

# Web Push VAPID Keys (Owner Mobile Order Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:vaphandicrafts@gmail.com

# Paytm Payment Gateway (Optional / Staging / Production)
# PAYTM_MID=your_paytm_mid
# PAYTM_MERCHANT_KEY=your_paytm_merchant_key
# PAYTM_WEBSITE=DEFAULT
# PAYTM_ENVIRONMENT=production

# Security & Cron
CRON_SECRET=your_cron_secret
